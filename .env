# Copy to .env and fill in. Real environment variables override this file.
# Any config.yaml key can be set as DP__<SECTION>__<KEY>.

# ---------------- Postgres (option A: individual fields)
DP__POSTGRES__HOST=20.127.220.153
DP__POSTGRES__PORT=5476
DP__POSTGRES__DATABASE=blockreconsit
DP__POSTGRES__USER=blockuser
DP__POSTGRES__PASSWORD=vinciluser
DP__POSTGRES__SSLMODE=prefer
DP__POSTGRES__SCHEMA=public
# ---------------- Postgres (option B: one DSN; wins over the fields above)
# DP__POSTGRES__DSN=postgresql://docparser:change-me@your-postgres-host:5432/recon?sslmode=require
#DP__POSTGRES__DSN=postgresql://docparser:change-me@your-postgres-host:5432/recon?sslmode=require

# ---------------- Kafka
DP__KAFKA__BOOTSTRAP_SERVERS=44.217.123.122:19095
DP__KAFKA__TOPIC=ocr-process-topic
DP__KAFKA__GROUP_ID=docparser-workers-anitha-test2
DP__KAFKA__RESULT_TOPIC=enrich-rule-topic-ani22
DP__KAFKA__DLQ_TOPIC=bd-ocr-flow-dlq
# Plain brokers: leave PLAINTEXT. Secured brokers, e.g. SASL_SSL + SCRAM:
DP__KAFKA__SECURITY_PROTOCOL=PLAINTEXT
# DP__KAFKA__SASL_MECHANISM=SCRAM-SHA-512
# DP__KAFKA__SASL_USERNAME=docparser
# DP__KAFKA__SASL_PASSWORD=change-me
# DP__KAFKA__SSL_CA_LOCATION=/certs/ca.pem
DP_DEV_ENDPOINTS=true
DP_FIXTURES_DIR=tests/fixtures
# ---------------- Files the worker reads (host folder mounted into containers)
BLOCDATA_DIR=/blocdata
DP__STORAGE__ALLOWED_ROOTS=["C:/Users/Anitha/Downloads/diffChecker"]